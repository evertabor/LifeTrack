<aside id="app-authenticated-sidebar" class="app-sidebar app-on-dark" data-app-sidebar aria-hidden="false" aria-label="Navegación de la aplicación">
    <div class="app-sidebar__header">
        <div>
            <a class="app-sidebar__brand" asp-controller="Categories" asp-action="Index"><span class="app-sidebar__brand-mark" aria-hidden="true">L</span>LifeTrack</a>
            <p class="app-sidebar__tagline">Control financiero personal</p>
        </div>
        <button class="app-sidebar__close" type="button" data-app-nav-close aria-label="Cerrar navegación"><span aria-hidden="true">×</span></button>
    </div>
    <nav class="app-nav" aria-label="Navegación principal">
        <p class="app-nav__heading">Finanzas</p>
        <ul class="app-nav__list">
            @if (ViewData["ActiveSection"] as string == "Transactions")
            {
                <li><a class="app-nav__link" asp-controller="Transactions" asp-action="Index" aria-current="page"><span class="app-nav__icon" aria-hidden="true">≣</span><span>Movimientos</span><span class="app-nav__chevron" aria-hidden="true">›</span></a></li>
            }
            else
            {
                <li><a class="app-nav__link" asp-controller="Transactions" asp-action="Index"><span class="app-nav__icon" aria-hidden="true">≣</span><span>Movimientos</span><span class="app-nav__chevron" aria-hidden="true">›</span></a></li>
            }
            @if (ViewData["ActiveSection"] as string == "Categories")
            {
                <li><a class="app-nav__link" asp-controller="Categories" asp-action="Index" aria-current="page"><span class="app-nav__icon" aria-hidden="true">▦</span><span>Categorías</span><span class="app-nav__chevron" aria-hidden="true">›</span></a></li>
            }
            else
            {
                <li><a class="app-nav__link" asp-controller="Categories" asp-action="Index"><span class="app-nav__icon" aria-hidden="true">▦</span><span>Categorías</span><span class="app-nav__chevron" aria-hidden="true">›</span></a></li>
            }
        </ul>
    </nav>
    <div class="app-sidebar__account">
        <div class="app-sidebar__avatar" aria-hidden="true">LT</div>
        <div class="app-sidebar__account-copy">
            <span class="app-sidebar__account-label">Sesión activa</span>
            <span class="app-sidebar__account-text">Tu espacio personal</span>
        </div>
        <form method="post" asp-controller="Account" asp-action="Logout" data-app-validate>
            <button class="app-sidebar__logout" type="submit" aria-label="Cerrar sesión"><span aria-hidden="true">↪</span></button>
        </form>
    </div>
</aside>
