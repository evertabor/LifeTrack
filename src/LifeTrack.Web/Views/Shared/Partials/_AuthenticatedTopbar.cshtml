<header class="app-topbar">
    <div class="app-topbar__start">
        <button class="app-topbar__menu" type="button" data-app-nav-open aria-controls="app-authenticated-sidebar" aria-expanded="false" aria-label="Abrir navegación"><span aria-hidden="true">☰</span></button>
        @if (ViewData["Breadcrumb"] is string breadcrumb)
        {
            <nav class="app-topbar__breadcrumb" aria-label="Migas de pan">@breadcrumb</nav>
        }
    </div>
    <div class="app-topbar__tools">
        <button class="app-topbar__tool" type="button" data-app-theme-toggle aria-label="Activar tema oscuro" aria-pressed="false"><span aria-hidden="true">◐</span></button>
        <button class="app-topbar__tool" type="button" aria-label="Notificaciones no disponibles todavía" disabled><span aria-hidden="true">♧</span></button>
        <div class="app-topbar__user"><span class="app-topbar__avatar" aria-hidden="true">LT</span><span class="app-topbar__user-name">LifeTrack</span></div>
    </div>
</header>
