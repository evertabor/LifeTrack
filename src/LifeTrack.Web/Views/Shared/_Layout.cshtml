<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LifeTrack</title>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/bootstrap-overrides.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LifeTrack.Web.styles.css" asp-append-version="true" />
</head>
<body class="app-public-shell">
    <a class="app-skip-link" href="#main-content">Saltar al contenido</a>
    @if (ViewData["HidePublicHeader"] is not true)
    {
        <partial name="Partials/_PublicHeader" />
    }
    <main id="main-content" role="main" class="app-main app-public-main">
        <div class="app-container">
            @RenderBody()
        </div>
    </main>
    <partial name="Partials/_AppFooter" />
    <script src="~/lib/jquery/dist/jquery.min.js" defer></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" defer></script>
    <script src="~/js/shared/form-validation.js" asp-append-version="true" defer></script>
    <script src="~/js/shared/form-submit.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
