@model LifeTrack.Web.ViewModels.Transactions.TransactionEditViewModel

@{
    ViewData["Title"] = "Editar movimiento";
    ViewData["Breadcrumb"] = "Finanzas / Movimientos";
}

<section class="transactions-edit" aria-labelledby="transactions-edit-title">
    <header class="transactions-index__header">
        <p class="transactions-index__pretitle">Movimientos</p>
        <div class="transactions-index__heading">
            <div>
                <h1 id="transactions-edit-title">Editar movimiento</h1>
                <p class="transactions-index__description">Corrige los datos de tu movimiento. La categoría debe ser una de las tuyas.</p>
            </div>
        </div>
    </header>
    <div class="transactions-panel">
        <form class="transactions-edit__form" method="post" asp-controller="Transactions" asp-action="Edit" asp-route-id="@Model.Id" data-app-validate novalidate aria-labelledby="transactions-edit-title">
            <div asp-validation-summary="ModelOnly" class="field-validation-error" role="alert"></div>
            <div class="app-form-field">
                <label asp-for="Input.Type" class="form-label">Tipo</label>
                <select asp-for="Input.Type" class="form-select">
                    @if (Model.IsIncomeSelected)
                    {
                        <option value="true" selected>Ingreso</option>
                        <option value="false">Gasto</option>
                    }
                    else
                    {
                        <option value="true">Ingreso</option>
                        <option value="false" selected>Gasto</option>
                    }
                </select>
                <span asp-validation-for="Input.Type" class="field-validation-error"></span>
            </div>
            <div class="app-form-field">
                <label asp-for="Input.CategoryId" class="form-label">Categoría</label>
                <select asp-for="Input.CategoryId" class="form-select" required>
                    <option value="">Selecciona una categoría</option>
                    @foreach (var option in Model.CategoryOptions)
                    {
                        @if (option.IsSelected)
                        {
                            <option value="@option.Id" selected>@option.Name</option>
                        }
                        else
                        {
                            <option value="@option.Id">@option.Name</option>
                        }
                    }
                </select>
                <span asp-validation-for="Input.CategoryId" class="field-validation-error"></span>
            </div>
            <div class="app-form-field">
                <label asp-for="Input.Amount" class="form-label">Importe</label>
                <input asp-for="Input.Amount" class="form-control" type="text" inputmode="decimal" autocomplete="off" data-app-money aria-describedby="transaction-amount-help" required />
                <div id="transaction-amount-help" class="form-text">Introduce el importe sin símbolo de moneda.</div>
                <span asp-validation-for="Input.Amount" class="field-validation-error"></span>
            </div>
            <div class="app-form-field">
                <label asp-for="Input.Date" class="form-label">Fecha</label>
                <input asp-for="Input.Date" class="form-control" type="date" required />
                <span asp-validation-for="Input.Date" class="field-validation-error"></span>
            </div>
            <div class="app-form-field">
                <label asp-for="Input.Description" class="form-label">Descripción</label>
                <input asp-for="Input.Description" class="form-control" maxlength="@EditTransactionInputModel.DescriptionMaxLength" autocomplete="off" />
                <span asp-validation-for="Input.Description" class="field-validation-error"></span>
            </div>
            <div class="transactions-edit__actions">
                <a class="btn btn-secondary" asp-controller="Transactions" asp-action="Index">Cancelar</a>
                <button type="submit" class="btn btn-primary">Guardar cambios</button>
            </div>
        </form>
    </div>
</section>
