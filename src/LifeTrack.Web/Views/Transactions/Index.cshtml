@model LifeTrack.Web.ViewModels.Transactions.TransactionListViewModel

@{
    ViewData["Title"] = "Movimientos";
    ViewData["Breadcrumb"] = "Finanzas / Movimientos";
}

<section class="transactions-index" aria-labelledby="transactions-title">
    <header class="transactions-index__header">
        <p class="transactions-index__pretitle">Finanzas</p>
        <div class="transactions-index__heading">
            <div>
                <h1 id="transactions-title">Movimientos</h1>
                <p class="transactions-index__description">Registra tus ingresos y gastos y consulta el resumen del mes.</p>
            </div>
            <div class="transactions-index__actions">
                <button class="btn btn-primary transactions-index__action" type="button" data-modal-open="transaction-create-modal" aria-controls="transaction-create-modal">Registrar movimiento</button>
                <button class="btn btn-outline-secondary transactions-index__action" type="button" data-modal-open="transaction-import-modal" aria-controls="transaction-import-modal">Importar CSV</button>
                <button class="btn btn-outline-secondary transactions-index__action" type="button" data-modal-open="transaction-budget-modal" aria-controls="transaction-budget-modal">Definir presupuesto</button>
            </div>
        </div>
    </header>

    @if (Model.HasSuccessMessage)
    {
        <div class="app-alert app-alert--success" role="status">@Model.SuccessMessage</div>
    }

    <section class="transactions-filter" aria-labelledby="transactions-filter-title">
        <h2 id="transactions-filter-title" class="transactions-filter__title">Filtro del mes</h2>
        <form class="transactions-filter__form" method="get" asp-controller="Transactions" asp-action="Index">
            <div class="app-form-field transactions-filter__field">
                <label class="form-label" for="transactions-filter-year">Año</label>
                <input id="transactions-filter-year" name="year" class="form-control" type="number" value="@Model.Year" min="@SetBudgetInputModel.MinYear" max="@SetBudgetInputModel.MaxYear" required />
            </div>
            <div class="app-form-field transactions-filter__field">
                <label class="form-label" for="transactions-filter-month">Mes</label>
                <select id="transactions-filter-month" name="month" class="form-select">
                    @foreach (var option in Model.MonthOptions)
                    {
                        @if (option.IsSelected)
                        {
                            <option value="@option.Month" selected>@option.Name</option>
                        }
                        else
                        {
                            <option value="@option.Month">@option.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="app-form-field transactions-filter__field">
                <label class="form-label" for="transactions-filter-category">Categoría</label>
                <select id="transactions-filter-category" name="categoryId" class="form-select">
                    <option value="">Todas las categorías</option>
                    @foreach (var option in Model.CategoryOptions)
                    {
                        @if (option.IsSelected)
                        {
                            <option value="@option.Id" selected>@option.Name</option>
                        }
                        else
                        {
                            <option value="@option.Id">@option.Name</option>
                        }
                    }
                </select>
            </div>
            <button type="submit" class="btn btn-outline-secondary transactions-filter__submit">Filtrar</button>
        </form>
    </section>

    <section class="transactions-summary" aria-labelledby="transactions-summary-title">
        <h2 id="transactions-summary-title" class="transactions-summary__title">Resumen de @Model.MonthLabel</h2>
        <div class="transactions-summary__grid">
            <article class="transactions-metric">
                <p class="transactions-metric__label">Ingresos</p>
                <p class="transactions-metric__value app-amount app-amount--income">@Model.TotalIncomeText</p>
                <p class="transactions-metric__context">@Model.MonthLabel</p>
            </article>
            <article class="transactions-metric">
                <p class="transactions-metric__label">Gastos</p>
                <p class="transactions-metric__value app-amount app-amount--expense">@Model.TotalExpenseText</p>
                <p class="transactions-metric__context">@Model.MonthLabel</p>
            </article>
            <article class="transactions-metric">
                <p class="transactions-metric__label">Balance</p>
                <p class="transactions-metric__value app-amount">@Model.BalanceText</p>
                <p class="transactions-metric__context">@Model.MonthLabel</p>
            </article>
        </div>
    </section>

    <section class="transactions-panel" aria-labelledby="transactions-budgets-title">
        <h2 id="transactions-budgets-title" class="transactions-panel__title">Presupuestos de @Model.MonthLabel</h2>
        @if (Model.HasBudgets)
        {
            <div class="transactions-budgets__list">
                @foreach (var budget in Model.Budgets)
                {
                    <div class="@budget.ProgressCssClass">
                    <div class="app-progress__header">
                        <span class="app-progress__label">@budget.CategoryName</span>
                        <button class="app-progress__delete" type="button" data-modal-open="@budget.DeleteModalId" aria-controls="@budget.DeleteModalId" aria-label="@budget.DeleteLabel"><span aria-hidden="true">🗑</span></button>
                        <span class="app-progress__value app-amount">@budget.UsageText</span>
                    </div>
                        <div class="app-progress__track" role="progressbar" aria-label="@budget.AriaLabel" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@budget.ProgressBarValue" aria-valuetext="@budget.PercentText">
                            <div class="app-progress__fill" data-transactions-percent="@budget.FillPercent"></div>
                        </div>
                        <p class="app-progress__status"><span class="@budget.StatusCssClass">@budget.StateText</span></p>
                    </div>
                }
            </div>
            @foreach (var budget in Model.Budgets)
            {
                <partial name="Partials/_BudgetDeleteForm" model="budget" />
            }
        }
        else
        {
            <p class="transactions-budgets__empty">Sin presupuestos este mes. Define el primero para controlar tu gasto por categoría.</p>
        }
    </section>

    @if (Model.HasExpenseByCategory)
    {
        <section class="transactions-panel" aria-labelledby="transactions-by-category-title">
            <h2 id="transactions-by-category-title" class="transactions-panel__title">Gasto por categoría</h2>
            <div class="transactions-table-wrapper">
                <table class="transactions-table">
                    <caption class="visually-hidden">Gasto por categoría</caption>
                    <thead>
                        <tr><th scope="col">Categoría</th><th scope="col" class="text-end">Total</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var group in Model.ExpenseByCategory)
                        {
                            <tr>
                                <td data-transactions-label="Categoría">@group.CategoryName</td>
                                <td data-transactions-label="Total" class="text-end app-amount app-amount--expense">@group.TotalText</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }

    <section class="transactions-panel" aria-labelledby="transactions-list-title">
        <h2 id="transactions-list-title" class="transactions-panel__title">Movimientos del mes</h2>
        @if (Model.HasTransactions)
        {
            <div class="transactions-table-wrapper">
                <table class="transactions-table">
                    <caption class="visually-hidden">Movimientos del mes</caption>
                    <thead>
                        <tr><th scope="col">Fecha</th><th scope="col">Categoría</th><th scope="col">Tipo</th><th scope="col">Descripción</th><th scope="col" class="text-end">Importe</th><th scope="col">Acciones</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var transaction in Model.Transactions)
                        {
                            <tr>
                                <td data-transactions-label="Fecha">@transaction.DateText</td>
                                <td data-transactions-label="Categoría">@transaction.CategoryName</td>
                                <td data-transactions-label="Tipo">@transaction.TypeLabel</td>
                                <td data-transactions-label="Descripción">@transaction.Description</td>
                                <td data-transactions-label="Importe" class="text-end @transaction.AmountCssClass">@transaction.AmountText</td>
                                <td>
                                    <span class="transactions-table__actions">
                                        <button class="btn btn-sm btn-secondary" type="button" data-modal-open="@transaction.EditModalId" aria-controls="@transaction.EditModalId" aria-label="@transaction.EditLabel"><span aria-hidden="true">✎</span></button>
                                        <button class="btn btn-sm btn-danger" type="button" data-modal-open="@transaction.DeleteModalId" aria-controls="@transaction.DeleteModalId" aria-label="@transaction.DeleteLabel"><span aria-hidden="true">🗑</span></button>
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @foreach (var transaction in Model.Transactions)
            {
                <partial name="Partials/_TransactionEditForm" model="transaction" />
                <partial name="Partials/_TransactionDeleteForm" model="transaction" />
            }
        }
        else
        {
            <div class="transactions-empty">
                <h3 class="transactions-empty__title">Sin movimientos este mes</h3>
                <p class="transactions-empty__text">Registra tu primer movimiento para empezar el resumen.</p>
                <button class="btn btn-primary transactions-empty__action" type="button" data-modal-open="transaction-create-modal" aria-controls="transaction-create-modal">Registrar movimiento</button>
                <button class="btn btn-outline-secondary transactions-empty__action" type="button" data-modal-open="transaction-import-modal" aria-controls="transaction-import-modal">Importar CSV</button>
                <button class="btn btn-outline-secondary transactions-empty__action" type="button" data-modal-open="transaction-budget-modal" aria-controls="transaction-budget-modal">Definir presupuesto</button>
            </div>
        }
    </section>

    <partial name="Partials/_TransactionForm" model="Model" />
    <partial name="Partials/_TransactionImportForm" model="Model" />
    <partial name="Partials/_TransactionBudgetForm" model="Model" />
</section>

@section Scripts {
    <script src="~/js/pages/transactions.js" asp-append-version="true" defer></script>
}
