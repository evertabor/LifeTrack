@model LifeTrack.Web.ViewModels.Transactions.TransactionListViewModel

<div class="modal fade transactions-modal" id="transaction-budget-modal" tabindex="-1" aria-labelledby="transaction-budget-modal-title" aria-hidden="true" data-app-modal data-transactions-budget-modal>
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content transactions-form" method="post" asp-controller="Transactions" asp-action="SetBudget" aria-labelledby="transaction-budget-modal-title" data-app-validate novalidate>
            <div class="modal-header">
                <div class="transactions-form__intro">
                    <p class="transactions-form__eyebrow">Presupuestos</p>
                    <h2 id="transaction-budget-modal-title" class="transactions-form__title">Definir presupuesto</h2>
                    <p class="transactions-form__description">Fija el gasto máximo de una categoría para el mes.</p>
                </div>
                <button type="button" class="btn-close" data-modal-close aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div asp-validation-summary="ModelOnly" class="field-validation-error" role="alert"></div>
                <input type="hidden" asp-for="NewBudget.Year" />
                <input type="hidden" asp-for="NewBudget.Month" />
                <div class="app-form-field">
                    <label asp-for="NewBudget.CategoryId" class="form-label">Categoría</label>
                    <select asp-for="NewBudget.CategoryId" class="form-select">
                        <option value="">Selecciona una categoría</option>
                        @foreach (var option in Model.CreateCategoryOptions)
                        {
                            @if (option.IsSelected)
                            {
                                <option value="@option.Id" selected>@option.Name</option>
                            }
                            else
                            {
                                <option value="@option.Id">@option.Name</option>
                            }
                        }
                    </select>
                    <span asp-validation-for="NewBudget.CategoryId" class="field-validation-error"></span>
                </div>
                <div class="app-form-field">
                    <label asp-for="NewBudget.Limit" class="form-label">Límite</label>
                    <input asp-for="NewBudget.Limit" class="form-control" type="number" step="0.01" min="0.01" inputmode="decimal" autocomplete="off" aria-describedby="transactions-budget-limit-help" />
                    <div id="transactions-budget-limit-help" class="form-text">Importe sin símbolo de moneda.</div>
                    <span asp-validation-for="NewBudget.Limit" class="field-validation-error"></span>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-modal-close>Cancelar</button>
                <button type="submit" class="btn btn-primary">Definir presupuesto</button>
            </div>
        </form>
    </div>
</div>
