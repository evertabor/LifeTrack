@model LifeTrack.Web.ViewModels.Transactions.TransactionRowViewModel

<div class="modal fade transactions-modal" id="@Model.EditModalId" tabindex="-1" aria-labelledby="@Model.EditModalTitleId" aria-hidden="true" data-app-modal>
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content transactions-form" method="post" asp-controller="Transactions" asp-action="Edit" asp-route-id="@Model.Id" aria-labelledby="@Model.EditModalTitleId" data-app-validate novalidate>
            <div class="modal-header">
                <div class="transactions-form__intro">
                    <p class="transactions-form__eyebrow">Editar registro</p>
                    <h2 id="@Model.EditModalTitleId" class="transactions-form__title">Editar movimiento</h2>
                    <p class="transactions-form__description">Corrige los datos de tu movimiento. La categoría debe ser una de las tuyas.</p>
                </div>
                <button type="button" class="btn-close" data-modal-close aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div asp-validation-summary="ModelOnly" class="field-validation-error" role="alert"></div>
                <div class="app-form-field">
                    <label asp-for="Input.Type" class="form-label">Tipo</label>
                    <select asp-for="Input.Type" class="form-select">
                        @if (Model.IsIncome)
                        {
                            <option value="true" selected>Ingreso</option>
                            <option value="false">Gasto</option>
                        }
                        else
                        {
                            <option value="true">Ingreso</option>
                            <option value="false" selected>Gasto</option>
                        }
                    </select>
                    <span asp-validation-for="Input.Type" class="field-validation-error"></span>
                </div>
                <div class="app-form-field">
                    <label asp-for="Input.CategoryId" class="form-label">Categoría</label>
                    <select asp-for="Input.CategoryId" class="form-select" required>
                        <option value="">Selecciona una categoría</option>
                        @foreach (var option in Model.CategoryOptions)
                        {
                            @if (option.IsSelected)
                            {
                                <option value="@option.Id" selected>@option.Name</option>
                            }
                            else
                            {
                                <option value="@option.Id">@option.Name</option>
                            }
                        }
                    </select>
                    <span asp-validation-for="Input.CategoryId" class="field-validation-error"></span>
                </div>
                <div class="app-form-field">
                    <label asp-for="Input.Amount" class="form-label">Importe</label>
                    <input asp-for="Input.Amount" class="form-control" type="text" inputmode="decimal" autocomplete="off" data-app-money aria-describedby="@Model.EditAmountHelpId" required />
                    <div id="@Model.EditAmountHelpId" class="form-text">Introduce el importe sin símbolo de moneda.</div>
                    <span asp-validation-for="Input.Amount" class="field-validation-error"></span>
                </div>
                <div class="app-form-field">
                    <label asp-for="Input.Date" class="form-label">Fecha</label>
                    <input asp-for="Input.Date" class="form-control" type="date" required />
                    <span asp-validation-for="Input.Date" class="field-validation-error"></span>
                </div>
                <div class="app-form-field">
                    <label asp-for="Input.Description" class="form-label">Descripción</label>
                    <input asp-for="Input.Description" class="form-control" maxlength="@EditTransactionInputModel.DescriptionMaxLength" autocomplete="off" />
                    <span asp-validation-for="Input.Description" class="field-validation-error"></span>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-modal-close>Cancelar</button>
                <button type="submit" class="btn btn-primary">Guardar cambios</button>
            </div>
        </form>
    </div>
</div>
