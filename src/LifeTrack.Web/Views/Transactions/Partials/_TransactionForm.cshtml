@model LifeTrack.Web.ViewModels.Transactions.TransactionListViewModel

<div class="modal fade transactions-modal" id="transaction-create-modal" tabindex="-1" aria-labelledby="transaction-create-modal-title" aria-hidden="true" data-app-modal data-transactions-create-modal>
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content transactions-form" method="post" asp-controller="Transactions" asp-action="Create" aria-labelledby="transaction-create-modal-title" data-app-validate novalidate>
            <div class="modal-header">
                <div class="transactions-form__intro">
                    <p class="transactions-form__eyebrow">Crear registro</p>
                    <h2 id="transaction-create-modal-title" class="transactions-form__title">Nuevo movimiento</h2>
                    <p class="transactions-form__description">Registra un ingreso o un gasto del mes.</p>
                </div>
                <button type="button" class="btn-close" data-modal-close aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div asp-validation-summary="ModelOnly" class="field-validation-error" role="alert"></div>
                <span asp-validation-for="NewTransaction" class="field-validation-error" role="alert"></span>
                <div class="app-form-field">
                    <label asp-for="NewTransaction.Type" class="form-label">Tipo</label>
                    <select asp-for="NewTransaction.Type" class="form-select" data-transactions-type>
                        @if (Model.IsIncomeSelected)
                        {
                            <option value="true" selected>Ingreso</option>
                            <option value="false">Gasto</option>
                        }
                        else
                        {
                            <option value="true">Ingreso</option>
                            <option value="false" selected>Gasto</option>
                        }
                    </select>
                    <span asp-validation-for="NewTransaction.Type" class="field-validation-error"></span>
                </div>
                <div class="app-form-field">
                    <label asp-for="NewTransaction.CategoryId" class="form-label">Categoría</label>
                    <select asp-for="NewTransaction.CategoryId" class="form-select" aria-describedby="transaction-category-help" required data-transactions-category>
                        <option value="">Selecciona una categoría</option>
                        @foreach (var option in Model.CreateCategoryOptions)
                        {
                            @if (option.IsSelected)
                            {
                                <option value="@option.Id" data-transactions-kind="@option.KindText" selected>@option.Name</option>
                            }
                            else
                            {
                                <option value="@option.Id" data-transactions-kind="@option.KindText">@option.Name</option>
                            }
                        }
                    </select>
                    <div id="transaction-category-help" class="form-text">Clasifica el movimiento en una de tus categorías.</div>
                    <span asp-validation-for="NewTransaction.CategoryId" class="field-validation-error"></span>
                </div>
                <div class="app-form-field">
                    <label asp-for="NewTransaction.Amount" class="form-label">Importe</label>
                    <input asp-for="NewTransaction.Amount" class="form-control" type="text" inputmode="decimal" autocomplete="off" data-app-money aria-describedby="transaction-amount-help" required maxlength="16" />
                    <div id="transaction-amount-help" class="form-text">Introduce el importe sin símbolo de moneda.</div>
                    <span asp-validation-for="NewTransaction.Amount" class="field-validation-error"></span>
                </div>
                <div class="app-form-field">
                    <label asp-for="NewTransaction.Date" class="form-label">Fecha</label>
                    <input asp-for="NewTransaction.Date" class="form-control" type="date" min="@Model.MinTransactionDateText" max="@Model.MaxTransactionDateText" aria-describedby="transaction-date-help" required />
                    <div id="transaction-date-help" class="form-text">@Model.TransactionDateHelpText</div>
                    <span asp-validation-for="NewTransaction.Date" class="field-validation-error"></span>
                </div>
                <div class="app-form-field">
                    <label asp-for="NewTransaction.Description" class="form-label">Descripción</label>
                    <input asp-for="NewTransaction.Description" class="form-control" maxlength="@CreateTransactionInputModel.DescriptionMaxLength" autocomplete="off" aria-describedby="transaction-description-help" />
                    <div id="transaction-description-help" class="form-text">Opcional, máximo 200 caracteres.</div>
                    <span asp-validation-for="NewTransaction.Description" class="field-validation-error"></span>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-modal-close>Cancelar</button>
                <button type="submit" class="btn btn-primary">Registrar movimiento</button>
            </div>
        </form>
    </div>
</div>
