@model LifeTrack.Web.ViewModels.Account.RegisterViewModel

@{
    ViewData["Title"] = "Crear cuenta";
}

<section class="app-auth" aria-labelledby="register-title">
    <div class="app-auth__shell">
        <div class="app-auth__card">
            <header class="app-auth__header">
                <p class="app-auth__eyebrow">Empieza hoy</p>
                <h1 id="register-title">Crear cuenta</h1>
                <p class="app-auth__intro">Empieza a organizar tus finanzas y hábitos en un solo lugar.</p>
            </header>
        <form class="app-auth__form" method="post" asp-action="Register" data-app-validate novalidate>
            <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
            <div class="app-form-field">
                <label asp-for="Email" class="form-label">Correo electrónico</label>
                <input asp-for="Email" class="form-control" type="email" autocomplete="email" aria-describedby="Email-error" required />
                <span asp-validation-for="Email" id="Email-error" class="field-validation-error"></span>
            </div>
            <div class="app-form-field">
                <label asp-for="DisplayName" class="form-label">Nombre para mostrar</label>
                <input asp-for="DisplayName" class="form-control" type="text" autocomplete="nickname" aria-describedby="DisplayName-help DisplayName-error" />
                <div id="DisplayName-help" class="form-text">Opcional. Así aparecerá tu nombre.</div>
                <span asp-validation-for="DisplayName" id="DisplayName-error" class="field-validation-error"></span>
            </div>
            <div class="app-form-field">
                <label asp-for="PhoneNumber" class="form-label">Teléfono</label>
                <input asp-for="PhoneNumber" class="form-control" type="tel" autocomplete="tel" aria-describedby="PhoneNumber-help PhoneNumber-error" />
                <div id="PhoneNumber-help" class="form-text">Opcional. No se verifica por SMS.</div>
                <span asp-validation-for="PhoneNumber" id="PhoneNumber-error" class="field-validation-error"></span>
            </div>
            <div class="app-form-field">
                <label asp-for="Password" class="form-label">Contraseña</label>
                <input asp-for="Password" class="form-control" type="password" autocomplete="new-password" aria-describedby="Password-help Password-error" minlength="@RegisterInputModel.MinPasswordLength" required />
                <div id="Password-help" class="form-text">@Model.PasswordHelpText</div>
                <span asp-validation-for="Password" id="Password-error" class="field-validation-error"></span>
            </div>
            <div class="app-form-field">
                <label asp-for="ConfirmPassword" class="form-label">Confirmar contraseña</label>
                <input asp-for="ConfirmPassword" class="form-control" type="password" autocomplete="new-password" aria-describedby="ConfirmPassword-error" required />
                <span asp-validation-for="ConfirmPassword" id="ConfirmPassword-error" class="field-validation-error"></span>
            </div>
            @if (Model.HasError)
            {
                <div id="register-error" class="app-alert app-alert--error" role="alert" aria-live="assertive">
                    <span>@Model.ErrorMessage</span>
                </div>
            }
            <button class="btn btn-primary app-auth__submit" type="submit">Crear cuenta</button>
            <p class="app-auth__switch">¿Ya tienes una cuenta? <a asp-controller="Account" asp-action="Login">Iniciar sesión</a></p>
        </form>
        </div>
    </div>
</section>
