@model LifeTrack.Web.ViewModels.Account.LoginViewModel

@{
    ViewData["Title"] = "Iniciar sesión";
    ViewData["HidePublicHeader"] = true;
}

<section class="app-auth app-auth--split" aria-labelledby="login-title">
    <div class="app-auth__shell app-auth__shell--split">
        <div class="app-auth__spotlight">
            <p class="app-auth__brand"><img class="app-auth__brand-icon" src="~/favicon.svg" alt="" aria-hidden="true" />LifeTrack</p>
            <p class="app-auth__tagline">Tus finanzas, bajo control.</p>
            <ul class="app-auth__highlights">
                <li><span aria-hidden="true">✓</span> Registra ingresos y gastos del mes.</li>
                <li><span aria-hidden="true">✓</span> Fija presupuestos por categoría.</li>
                <li><span aria-hidden="true">✓</span> Proyección de saldo a fin de mes.</li>
            </ul>
        </div>
        <div class="app-auth__card">
            <header class="app-auth__header">
                <p class="app-auth__eyebrow">Bienvenido de nuevo</p>
                <h1 id="login-title">Iniciar sesión</h1>
                <p class="app-auth__intro">Retoma el control de tus finanzas.</p>
            </header>
        <form class="app-auth__form" method="post" asp-action="Login" data-app-validate novalidate>
            <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
            <div class="app-form-field">
                <label asp-for="Email" class="form-label">Correo electrónico</label>
                <input asp-for="Email" class="form-control" type="email" autocomplete="email" aria-describedby="Email-error" required maxlength="@LoginInputModel.EmailMaxLength" />
                <span asp-validation-for="Email" id="Email-error" class="field-validation-error"></span>
            </div>
            <div class="app-form-field app-password-field" data-password-field>
                <label asp-for="Password" class="form-label">Contraseña</label>
                <input asp-for="Password" class="form-control" type="password" autocomplete="current-password" aria-describedby="Password-error" required maxlength="@LoginInputModel.PasswordMaxLength" data-password-input />
                <button type="button" class="app-password-toggle" aria-label="Mostrar" aria-pressed="false" data-password-toggle>
                    <svg data-password-toggle-show xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                    <svg data-password-toggle-hide xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" hidden><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                </button>
                <span asp-validation-for="Password" id="Password-error" class="field-validation-error"></span>
            </div>
            @if (Model.HasError)
            {
                <div id="login-error" class="app-alert app-alert--error" role="alert" aria-live="assertive">
                    <span>@Model.ErrorMessage</span>
                </div>
            }
            <button class="btn btn-primary app-auth__submit" type="submit">Iniciar sesión</button>
            <p class="app-auth__switch">¿Aún no tienes una cuenta? <a asp-controller="Account" asp-action="Register">Crear cuenta</a></p>
        </form>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/shared/password-toggle.js" asp-append-version="true" defer></script>
}
