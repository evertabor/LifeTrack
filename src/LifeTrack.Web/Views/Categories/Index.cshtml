@model LifeTrack.Web.ViewModels.Categories.CategoryListViewModel

@{
    ViewData["Title"] = "Categorías";
    ViewData["Breadcrumb"] = "Finanzas / Categorías";
}

<section class="categories-index" aria-labelledby="categories-title">
    <header class="categories-index__header">
        <p class="categories-index__pretitle">Configuración financiera</p>
        <div class="categories-index__heading">
            <div>
                <h1 id="categories-title">Categorías</h1>
                <p class="categories-index__description">Organiza tus movimientos para entender mejor en qué se va tu dinero.</p>
            </div>
            <button class="btn btn-primary categories-index__action" type="button" data-modal-open="category-create-modal" aria-controls="category-create-modal">Crear categoría</button>
        </div>
    </header>

    @if (Model.HasSuccessMessage)
    {
        <div class="app-alert app-alert--success" role="status">@Model.SuccessMessage</div>
    }

    <div class="categories-index__grid">
        <section class="app-card categories-panel" aria-labelledby="categories-list-title">
            <h2 id="categories-list-title" class="visually-hidden">Tus categorías</h2>
            <div class="categories-panel__toolbar">
                <form class="categories-panel__search" method="get" asp-controller="Categories" asp-action="Index" role="search">
                    <label class="visually-hidden" for="categories-search-input">Buscar en categorías</label>
                    <input id="categories-search-input" name="q" type="search" value="@Model.SearchTerm" placeholder="Buscar" autocomplete="off" />
                    <button type="submit" aria-label="Buscar"><span aria-hidden="true">⌕</span></button>
                </form>
                <span class="categories-panel__hint">Vista actual</span>
            </div>

            @if (Model.HasCategories)
            {
                <div class="categories-table-wrapper">
                    <table class="categories-table">
                        <caption class="visually-hidden">Lista de categorías</caption>
                        <thead>
                            <tr><th scope="col">Nombre de la categoría</th><th scope="col">Acciones</th></tr>
                        </thead>
                        <tbody>
                    @foreach (var category in Model.Categories)
                    {
                            <tr tabindex="0">
                                <td><span class="categories-table__name"><span class="categories-list__marker" aria-hidden="true"></span>@category.Name</span></td>
                                <td>
                                    <span class="categories-table__actions">
                                        <button class="btn btn-sm btn-secondary" type="button" data-modal-open="@category.EditModalId" aria-controls="@category.EditModalId" aria-label="@category.EditLabel"><span aria-hidden="true">✎</span></button>
                                        <button class="btn btn-sm btn-danger" type="button" data-modal-open="@category.DeleteModalId" aria-controls="@category.DeleteModalId" aria-label="@category.DeleteLabel"><span aria-hidden="true">🗑</span></button>
                                    </span>
                                </td>
                            </tr>
                    }
                        </tbody>
                    </table>
                </div>
                @foreach (var category in Model.Categories)
                {
                    <partial name="Partials/_CategoryEditForm" model="category" />
                    <partial name="Partials/_CategoryDeleteForm" model="category" />
                }
                @if (!Model.HasActiveSearch)
                {
                    <div class="categories-pagination" aria-label="Paginación de categorías">
                        <button type="button" disabled>Anterior</button><span>Página 1 · Todas visibles</span><button type="button" disabled>Siguiente</button>
                    </div>
                }
            }
            else
            {
                @if (Model.HasActiveSearch)
                {
                    <div class="categories-empty">
                        <h3 class="categories-empty__title">Sin resultados</h3>
                        <p class="categories-empty__text">@Model.NoResultsMessage</p>
                    </div>
                }
                else
                {
                    <div class="categories-empty">
                        <h3 class="categories-empty__title">Empieza por una categoría</h3>
                        <p class="categories-empty__text">Crea una categoría para clasificar tus ingresos y gastos.</p>
                        <button class="btn btn-primary categories-empty__action" type="button" data-modal-open="category-create-modal" aria-controls="category-create-modal">Crear categoría</button>
                    </div>
                }
            }
        </section>
    </div>

    <partial name="Partials/_CategoryForm" model="Model.NewCategory" />
</section>

@section Scripts {
    <script src="~/js/shared/modal.js" asp-append-version="true" defer></script>
    <script src="~/js/pages/categories.js" asp-append-version="true" defer></script>
}
