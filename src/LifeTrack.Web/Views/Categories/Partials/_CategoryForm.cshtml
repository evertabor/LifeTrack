@model LifeTrack.Web.ViewModels.Categories.CategoryFormViewModel

<form class="app-card categories-form" method="post" asp-controller="Categories" asp-action="Create" aria-labelledby="category-form-title">
    <div class="categories-form__intro">
        <p class="categories-form__eyebrow">Crear registro</p>
        <h2 id="category-form-title" class="categories-form__title">Nueva categoría</h2>
        <p class="categories-form__description">Añade una categoría para clasificar tus movimientos.</p>
    </div>
    <div class="app-form-field">
        <label asp-for="Name" class="form-label">Nombre</label>
        <input asp-for="Name" class="form-control" autocomplete="off" aria-describedby="category-name-help category-name-error" />
        <div id="category-name-help" class="form-text">Máximo 50 caracteres.</div>
        <span asp-validation-for="Name" class="field-validation-error" id="category-name-error"></span>
    </div>
    <button type="submit" class="btn btn-primary">Crear categoría</button>
</form>
