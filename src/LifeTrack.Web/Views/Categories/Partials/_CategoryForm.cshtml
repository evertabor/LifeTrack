@model LifeTrack.Web.ViewModels.Categories.CreateCategoryInputModel

<div class="modal fade categories-modal" id="category-create-modal" tabindex="-1" aria-labelledby="category-create-modal-title" aria-hidden="true" data-app-modal data-categories-create-modal>
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content categories-form" method="post" asp-controller="Categories" asp-action="Create" aria-labelledby="category-create-modal-title" data-app-validate novalidate>
            <div class="modal-header">
                <div class="categories-form__intro">
                    <p class="categories-form__eyebrow">Crear registro</p>
                    <h2 id="category-create-modal-title" class="categories-form__title">Nueva categoría</h2>
                    <p class="categories-form__description">Añade una categoría para clasificar tus movimientos.</p>
                </div>
                <button type="button" class="btn-close" data-modal-close aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="app-form-field">
                    <label asp-for="Name" class="form-label">Nombre</label>
                    <input asp-for="Name" class="form-control" autocomplete="off" aria-describedby="category-name-help category-name-error" required maxlength="@CreateCategoryInputModel.NameMaxLength" />
                    <div id="category-name-help" class="form-text">Máximo 50 caracteres.</div>
                    <span asp-validation-for="Name" class="field-validation-error" id="category-name-error"></span>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-modal-close>Cancelar</button>
                <button type="submit" class="btn btn-primary">Crear categoría</button>
            </div>
        </form>
    </div>
</div>
