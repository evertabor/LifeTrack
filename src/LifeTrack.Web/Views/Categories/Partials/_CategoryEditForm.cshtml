@model LifeTrack.Web.ViewModels.Categories.CategoryFormViewModel

<div class="modal fade categories-modal" id="@Model.EditModalId" tabindex="-1" aria-labelledby="@Model.EditModalTitleId" aria-hidden="true" data-app-modal>
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content categories-form" method="post" asp-controller="Categories" asp-action="Edit" asp-route-id="@Model.Id" aria-labelledby="@Model.EditModalTitleId" data-app-validate novalidate>
            <div class="modal-header">
                <div class="categories-form__intro">
                    <p class="categories-form__eyebrow">Editar registro</p>
                    <h2 id="@Model.EditModalTitleId" class="categories-form__title">Editar categoría</h2>
                    <p class="categories-form__description">El nuevo nombre debe ser único.</p>
                </div>
                <button type="button" class="btn-close" data-modal-close aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="app-form-field">
                    <label asp-for="NewName" class="form-label">Nombre</label>
                    <input asp-for="NewName" class="form-control" autocomplete="off" aria-describedby="@Model.EditHelpId" required maxlength="50" />
                    <div id="@Model.EditHelpId" class="form-text">Máximo 50 caracteres.</div>
                    <span asp-validation-for="NewName" class="field-validation-error"></span>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-modal-close>Cancelar</button>
                <button type="submit" class="btn btn-primary">Guardar cambios</button>
            </div>
        </form>
    </div>
</div>
